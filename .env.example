# cp .env.example .env 로 복사해 값을 채운 뒤 /jw:setup 에 이 파일 경로를 알려 주세요.
# /jw:setup(scripts/setup.sh --env-file)이 값을 ~/.config/my-claude-skills/secrets.env(권한 600)에 저장합니다.
# .env는 .gitignore에 있어 git에 올라가지 않습니다. 빈 값은 건너뜁니다.

# Vercel AI Gateway. gemini-rewrite가 Google API 402·429 때 대체 호출에 사용
AI_GATEWAY_API_KEY=

# gemini-rewrite (Google Gemini API)
GEMINI_API_KEY=

# paper-search (선택). 없어도 동작하지만 Semantic Scholar는 공용 한도라 429가 잦다
S2_API_KEY=
OPENALEX_API_KEY=

# naver-search (필수). 네이버 클라우드 콘솔 NAVER API HUB에서 Application 등록 후 Client ID·Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
