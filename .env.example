# cp .env.example .env 로 복사한 뒤 값을 채우고 ./install.sh를 실행하세요.
# install.sh가 값을 ~/.config/my-claude-skills/secrets.env(권한 600)에 저장합니다.
# .env는 .gitignore에 있어 git에 올라가지 않습니다. 빈 값은 건너뜁니다.

# Vercel AI Gateway. jev-eval에는 필수, gemini-rewrite에는 Google API 402·429 때 폴백용
AI_GATEWAY_API_KEY=

# gemini-rewrite (Google Gemini API)
GEMINI_API_KEY=
